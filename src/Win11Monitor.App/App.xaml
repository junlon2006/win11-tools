<Application x:Class="Win11Monitor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <Color x:Key="PageColor">#111315</Color>
    <Color x:Key="PanelColor">#1A1D20</Color>
    <Color x:Key="BorderColor">#343A40</Color>
    <Color x:Key="TextColor">#F4F5F6</Color>
    <Color x:Key="MutedColor">#A8AFB7</Color>
    <Color x:Key="AccentColor">#37B37E</Color>
    <SolidColorBrush x:Key="PageBrush" Color="{StaticResource PageColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource PageBrush}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#2A3035" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#111315" />
      <Setter Property="Background" Value="#F4F5F6" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Application.Resources>
</Application>
