<Window x:Class="Win11Monitor.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Z690 Monitor"
        Width="540"
        Height="680"
        MinWidth="500"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="24,20,24,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Z690 Monitor" FontSize="23" FontWeight="SemiBold" />
        <TextBlock Text="{Binding CpuName}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
        <TextBlock Text="{Binding LastUpdatedText}" FontSize="13" HorizontalAlignment="Right" />
        <TextBlock Text="实时更新" Foreground="{StaticResource MutedBrush}" FontSize="12" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Background="{StaticResource PanelBrush}">
      <Grid Margin="24,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="CPU 温度" FontSize="14" FontWeight="SemiBold" />
        <Grid Grid.Row="1" Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="平均" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="{Binding CpuTemperatureAverageText}" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0" />
          </StackPanel>
          <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="0,2" />
          <StackPanel Grid.Column="2" Margin="24,0,0,0">
            <TextBlock Text="最高核心" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="{Binding CpuTemperatureMaximumText}" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="24,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="{Binding VoltageSourceText}" FontSize="14" FontWeight="SemiBold" />
      <Grid Grid.Row="1" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="平均" Foreground="{StaticResource MutedBrush}" />
          <TextBlock Text="{Binding CpuVoltageAverageText}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="0,2" />
        <StackPanel Grid.Column="2" Margin="24,0,0,0">
          <TextBlock Text="最高核心" Foreground="{StaticResource MutedBrush}" />
          <TextBlock Text="{Binding CpuVoltageMaximumText}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
    </Grid>

    <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Background="{StaticResource PanelBrush}">
      <Grid Margin="24,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="PCH 温度" FontSize="14" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PchSourceText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,18,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding PchTemperatureText}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,17,24,12">
        <TextBlock Text="显示与传感器" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
        <CheckBox Content="在任务栏上方显示紧凑监控条" IsChecked="{Binding ShowTaskbarWidget}" Margin="0,0,0,12" />
        <CheckBox Content="登录 Windows 后自动启动（最高权限计划任务）" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,14" />
        <TextBlock Text="PCH 温度传感器" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
        <ComboBox ItemsSource="{Binding PchSensors}"
                  SelectedItem="{Binding SelectedPchSensor}"
                  DisplayMemberPath="DisplayName"
                  MaxDropDownHeight="220" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14,24,18">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,13,0,0">
          <Button Content="导出传感器报告" Click="ExportDiagnostics_Click" Margin="0,0,8,0" />
          <Button Content="隐藏到托盘" Click="Hide_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
